{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "noEmit": true,
    "isolatedModules": true
  },
  "include": [
    "src/**/*.tsx",
    "src/web/**/*.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "dist",
    "dist-web",
    "node_modules"
  ]
}
